# App base path and origins
NEXT_PUBLIC_APP_BASE_PATH=
APP_ORIGIN=http://localhost:3003
APP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3003

# Super Portal shared session authentication
AUTH_FLOW_SECRET=
AUTH_COOKIE_DOMAIN=
PORTAL_REQUIRED_SCOPES=tss:operations:access
PORTAL_REQUIRED_ROLES=
SUPER_PORTAL_LOGIN_URL=http://localhost:3000/login
SUPER_PORTAL_LOGOUT_URL=http://localhost:3000/api/auth/logout

# TSS Upstream Backend Service (WSO2 APIM Gateway)
TSS_API_BASE_URL=https://dev-apim.flyzagol.com:8251/tss/1.0
TSS_API_TOKEN=
WSO2_JWT_ASSERTION=

# Local standalone development auth override
USE_MOCK_AUTH=true
MOCK_ACTOR_ID=usr_tss_ops_01
MOCK_ACTOR_ROLES=tss:operator,tss:admin
MOCK_ACTOR_TYPE=OPERATOR
MOCK_TENANT_ID=

# Data source selection: 'mock' (local fixtures) or 'remote' (live TSS BFF proxy)
NEXT_PUBLIC_DATA_SOURCE=remote
